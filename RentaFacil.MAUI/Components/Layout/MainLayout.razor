@inherits LayoutComponentBase
@using RentaFacil.MAUI.Services
@inject AuthService Auth
@inject NavigationManager Nav

<CascadingValue Value="this">
    <div class="page-mobile">
        <main class="w-100">
            @Body
        </main>
    </div>

    @if (isSidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="ToggleSidebar"></div>
        <div class="sidebar-offcanvas slide-in-left">
            <NavMenu OnClose="ToggleSidebar" />
        </div>
    }
</CascadingValue>

<style>
    .page-mobile {
        width: 100%;
        min-height: 100vh;
        background-color: #f4f6f9; /* Color de fondo claro */
    }
    .sidebar-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.6);
        z-index: 2000;
    }
    .sidebar-offcanvas {
        position: fixed;
        top: 0; left: 0; bottom: 0;
        width: 280px;
        background: white;
        z-index: 2010;
        box-shadow: 2px 0 10px rgba(0,0,0,0.2);
        overflow-y: auto;
    }
    .slide-in-left {
        animation: slideInLeft 0.3s ease forwards;
    }
    @@keyframes slideInLeft {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
    }
</style>

@code {
    public bool isSidebarOpen = false;

    public void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Auth.OnAuthStateChanged += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= StateHasChanged;
    }
}
