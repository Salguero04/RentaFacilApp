@page "/contratos/nuevo"
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Enums
@using RentaFacil.MAUI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: -1rem -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem;" @onclick="GoBack">
        <i class="bi bi-arrow-left fs-4"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Registrar Contrato</h3>
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; opacity: 0.85;">
        <i class="bi bi-person-plus fs-4"></i>
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger m-3">@errorMessage</div>
}

<!-- PARTICIPANTES -->
<h6 class="text-secondary fw-bold ms-2 mb-2" style="font-size: 0.8rem; letter-spacing: 1px;">PARTICIPANTES</h6>
<div class="card border rounded-4 mb-4 shadow-sm">
    <div class="card-body p-3">
        <!-- Inquilino Selection -->
        <div class="border rounded-4 p-3 mb-3 d-flex align-items-center @(inquilinoSeleccionado == null ? "border-danger" : "border-success bg-success bg-opacity-10")" @onclick="AbrirSelectorInquilino" style="cursor:pointer;">
            <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-person-fill fs-2 text-secondary"></i>
            </div>
            <div class="flex-grow-1">
                @if (inquilinoSeleccionado == null)
                {
                    <h6 class="fw-bold text-danger mb-0">Seleccionar Inquilino</h6>
                    <small class="text-danger opacity-75">Requerido para el registro</small>
                }
                else
                {
                    <h6 class="fw-bold text-success mb-0">@inquilinoSeleccionado.NombreCompleto</h6>
                    <small class="text-success opacity-75">DNI: @inquilinoSeleccionado.Identificacion</small>
                }
            </div>
            <i class="bi bi-person-lines-fill text-danger fs-5"></i>
        </div>

        <!-- Inmueble Selection -->
        <div class="border rounded-4 p-3 d-flex align-items-center @(unidadSeleccionada == null ? "border-danger" : "border-success bg-success bg-opacity-10")" @onclick="AbrirSelectorUnidad" style="cursor:pointer;">
            <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-door-fill fs-2 text-secondary"></i>
            </div>
            <div class="flex-grow-1">
                @if (unidadSeleccionada == null)
                {
                    <h6 class="fw-bold text-danger mb-0">Seleccionar Inmueble</h6>
                    <small class="text-danger opacity-75">Este campo es obligatorio</small>
                }
                else
                {
                    <h6 class="fw-bold text-success mb-0">@unidadSeleccionada.Nombre</h6>
                    <small class="text-success opacity-75">Inmueble ID: @unidadSeleccionada.InmuebleId</small>
                }
            </div>
            <i class="bi bi-search text-danger fs-5"></i>
        </div>
    </div>
</div>

<!-- DETALLES DEL PAGO -->
<h6 class="text-secondary fw-bold ms-2 mb-2" style="font-size: 0.8rem; letter-spacing: 1px;">DETALLES DEL PAGO</h6>
<div class="card border rounded-4 mb-4 shadow-sm">
    <div class="card-body p-3">
        <!-- Frecuencia -->
        <div class="position-relative mb-4">
            <span class="position-absolute top-0 start-0 ms-3 mt-n2 bg-white px-2 small text-muted">Frecuencia de Pago</span>
            <select class="form-select border-0 shadow-none pt-4 pb-2 fw-bold text-dark fs-6" style="background-color: #f8f9fa; border-radius: 12px;" @bind="frecuencia">
                <option value="@FrecuenciaPago.Mensual">Mensual</option>
                <option value="@FrecuenciaPago.Quincenal">Quincenal</option>
                <option value="@FrecuenciaPago.Semanal">Semanal</option>
            </select>
        </div>

        <!-- Duración -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="fw-bold text-dark">Duración del contrato (Meses)</span>
            <div class="d-flex align-items-center bg-light rounded-pill p-1">
                <button class="btn btn-danger rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 30px; height: 30px;" @onclick="RestarMeses">
                    <i class="bi bi-dash fw-bold"></i>
                </button>
                <span class="fw-bold mx-3 fs-5">@duracionMeses</span>
                <button class="btn btn-success rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 30px; height: 30px;" @onclick="SumarMeses">
                    <i class="bi bi-plus fw-bold"></i>
                </button>
            </div>
        </div>

        <!-- Monto y Garantía -->
        <div class="d-flex align-items-center mb-2">
            <div class="bg-info text-white rounded-3 d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div class="flex-grow-1 row gx-2">
                <div class="col-6">
                    <input type="number" class="form-control text-center fw-bold text-secondary border rounded-4 py-2" placeholder="Monto" @bind="monto" step="0.01" />
                </div>
                <div class="col-6">
                    <input type="number" class="form-control text-center fw-bold text-secondary border rounded-4 py-2" placeholder="Garantía" @bind="garantia" step="0.01" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FECHAS Y VIGENCIA -->
<h6 class="text-secondary fw-bold ms-2 mb-2" style="font-size: 0.8rem; letter-spacing: 1px;">FECHAS Y VIGENCIA</h6>
<div class="card border rounded-4 mb-4 shadow-sm">
    <div class="card-body p-3">
        <div class="border rounded-4 p-2 mb-3 d-flex align-items-center">
            <i class="bi bi-calendar3 fs-5 mx-2 text-dark"></i>
            <div class="flex-grow-1">
                <small class="text-muted d-block ms-1" style="font-size: 0.7rem;">Fecha Inicio</small>
                <input type="date" class="form-control border-0 shadow-none fw-bold p-1" @bind="fechaInicio" @bind:event="oninput" />
            </div>
        </div>
        <div class="border rounded-4 p-2 d-flex align-items-center bg-light">
            <i class="bi bi-calendar3 fs-5 mx-2 text-secondary"></i>
            <div class="flex-grow-1">
                <small class="text-muted d-block ms-1" style="font-size: 0.7rem;">Fecha Fin (Calculada)</small>
                <input type="date" class="form-control border-0 shadow-none fw-bold bg-transparent p-1 text-secondary" value="@fechaFinCalculada.ToString("yyyy-MM-dd")" readonly />
            </div>
        </div>
    </div>
</div>

<!-- ADICIONAL -->
<h6 class="text-secondary fw-bold ms-2 mb-2" style="font-size: 0.8rem; letter-spacing: 1px;">ADICIONAL</h6>
<div class="card border rounded-4 mb-4 shadow-sm">
    <div class="card-body p-3 d-flex align-items-start">
        <i class="bi bi-pencil-square fs-5 me-3 mt-1 text-secondary"></i>
        <textarea class="form-control border-0 shadow-none p-0 text-secondary" rows="2" placeholder="Observaciones internas..." @bind="observaciones"></textarea>
    </div>
</div>

<div class="row gx-3 mb-4">
    <div class="col-4">
        <button class="btn btn-light w-100 py-3 fw-bold rounded-4 border" @onclick="GoBack">Cancelar</button>
    </div>
    <div class="col-8">
        <button class="btn btn-info text-white w-100 py-3 fw-bold rounded-4 shadow" @onclick="GuardarContrato">GUARDAR CONTRATO</button>
    </div>
</div>

<!-- Bottom Sheet Selector Inquilinos -->
@if (mostrarSelectorInquilino)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarSelectores"></div>
    <div class="bottom-sheet slide-up p-3" style="max-height: 60vh; overflow-y: auto;">
        <h5 class="fw-bold mb-3 text-center">Seleccionar Inquilino</h5>
        @if (todosInquilinos == null)
        {
            <p class="text-center">Cargando...</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var inq in todosInquilinos)
                {
                    <button class="list-group-item list-group-item-action py-3 d-flex align-items-center" @onclick="() => SeleccionarInquilino(inq)">
                        <i class="bi bi-person-circle fs-3 me-3 text-secondary"></i>
                        <div>
                            <span class="fw-bold d-block">@inq.NombreCompleto</span>
                            <small class="text-muted">DNI: @inq.Identificacion</small>
                        </div>
                    </button>
                }
            </div>
        }
    </div>
}

<!-- Bottom Sheet Selector Unidades -->
@if (mostrarSelectorUnidad)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarSelectores"></div>
    <div class="bottom-sheet slide-up p-3" style="max-height: 60vh; overflow-y: auto;">
        <h5 class="fw-bold mb-3 text-center">Seleccionar Inmueble (Unidad)</h5>
        @if (todasUnidades == null)
        {
            <p class="text-center">Cargando...</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var uni in todasUnidades)
                {
                    <button class="list-group-item list-group-item-action py-3 d-flex align-items-center" @onclick="() => SeleccionarUnidad(uni)">
                        <i class="bi bi-house-door fs-3 me-3 text-primary"></i>
                        <div>
                            <span class="fw-bold d-block">@uni.Nombre</span>
                            <small class="text-muted">ID: @uni.Id</small>
                        </div>
                    </button>
                }
            </div>
        }
    </div>
}

<!-- Modal Confirmación -->
@if (mostrarExito)
{
    <div class="modal-overlay"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 70px; height: 70px;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        <h4 class="fw-bold text-success mb-2">Contrato Creado</h4>
        <p class="text-muted mb-4">El contrato ha sido registrado exitosamente.</p>
        <button class="btn btn-success py-2 px-4 fw-bold rounded-pill" @onclick="GoBack">Volver</button>
    </div>
}

<style>
    .mt-n2 { margin-top: -0.5rem !important; }
    .bottom-sheet-overlay, .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .bottom-sheet {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: white; border-radius: 20px 20px 0 0; z-index: 1050;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 350px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .slide-up { animation: slideUp 0.3s ease-out forwards; }
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .scale-in { animation: scaleIn 0.3s ease; }
    @@keyframes scaleIn { from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
</style>

@code {
    private List<InquilinoDto>? todosInquilinos;
    private List<UnidadDto>? todasUnidades;

    private InquilinoDto? inquilinoSeleccionado;
    private UnidadDto? unidadSeleccionada;

    private bool mostrarSelectorInquilino = false;
    private bool mostrarSelectorUnidad = false;
    private bool mostrarExito = false;

    private FrecuenciaPago frecuencia = FrecuenciaPago.Mensual;
    private int duracionMeses = 12;
    private decimal monto;
    private decimal garantia;
    private string errorMessage = "";
    
    private DateTime _fechaInicio = DateTime.Today;
    private DateTime fechaInicio 
    {
        get => _fechaInicio;
        set 
        {
            _fechaInicio = value;
        }
    }
    private DateTime fechaFinCalculada => fechaInicio.AddMonths(duracionMeses);
    
    private string observaciones = "";

    protected override async Task OnInitializedAsync()
    {
        todosInquilinos = await Api.GetInquilinosAsync();
        todasUnidades = await Api.GetUnidadesAsync();
    }

    private void SumarMeses() => duracionMeses++;
    private void RestarMeses()
    {
        if (duracionMeses > 1) duracionMeses--;
    }

    private void AbrirSelectorInquilino() { mostrarSelectorInquilino = true; mostrarSelectorUnidad = false; }
    private void AbrirSelectorUnidad() { mostrarSelectorUnidad = true; mostrarSelectorInquilino = false; }
    private void CerrarSelectores() { mostrarSelectorInquilino = false; mostrarSelectorUnidad = false; }

    private void SeleccionarInquilino(InquilinoDto inq)
    {
        inquilinoSeleccionado = inq;
        CerrarSelectores();
    }

    private void SeleccionarUnidad(UnidadDto uni)
    {
        unidadSeleccionada = uni;
        monto = uni.MontoRenta; // Autocompletado con la renta de la unidad
        garantia = 0; // No hay garantía sugerida en UnidadDto
        CerrarSelectores();
    }

    private async Task GuardarContrato()
    {
        if (inquilinoSeleccionado == null || unidadSeleccionada == null || monto <= 0) return;

        errorMessage = "";
        var dto = new CrearContratoDto(
            InquilinoId: inquilinoSeleccionado.Id,
            UnidadId: unidadSeleccionada.Id,
            Monto: monto,
            Garantia: garantia,
            Frecuencia: frecuencia,
            DuracionMeses: duracionMeses,
            DiaPago: fechaInicio.Day,
            FechaInicio: fechaInicio,
            Observaciones: observaciones
        );

        try
        {
            var result = await Api.CrearContratoAsync(dto);
            if (result != null)
            {
                mostrarExito = true;
            }
            else
            {
                errorMessage = "No se pudo registrar el contrato. Verifica el inquilino y la unidad seleccionados.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar el contrato: {ex.Message}";
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/contratos");
    }
}
