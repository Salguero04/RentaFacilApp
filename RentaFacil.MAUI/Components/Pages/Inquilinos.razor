@page "/inquilinos"
@using RentaFacil.Shared.Models
@using RentaFacil.MAUI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem;" @onclick="GoBack">
        <i class="bi bi-arrow-left fs-4"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Mis Inquilinos</h3>
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; opacity: 0.85;">
        <i class="bi bi-search" style="font-size: 1.4rem;"></i>
    </button>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh; position: relative;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando inquilinos...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else
    {
        <div class="text-center mb-4 mt-2">
            <span class="bg-primary bg-opacity-10 text-primary fw-bold px-4 py-2 rounded-pill">Total: @inquilinos.Count Registrados</span>
        </div>

        @if (!inquilinos.Any())
        {
            <div class="text-center text-muted mt-5">
                <i class="bi bi-people fs-1 d-block mb-3"></i>
                <p>No tienes inquilinos registrados aún.</p>
            </div>
        }
        else
        {
            @foreach (var inq in inquilinos)
            {
                <div class="card shadow-sm border-0 mb-3 rounded-4" @onclick="() => AbrirOpciones(inq)" style="cursor: pointer; transition: all 0.2s;">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                                <i class="bi bi-person-fill fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@inq.NombreCompleto.ToUpper()</h6>
                                <small class="text-muted d-block">DNI: @inq.Identificacion</small>
                                <small class="text-primary fw-bold"><i class="bi bi-telephone-fill me-1"></i>@inq.Telefono</small>
                            </div>
                        </div>
                        <i class="bi bi-three-dots-vertical fs-5 text-muted"></i>
                    </div>
                </div>
            }
        }

        <button class="btn btn-primary btn-lg rounded-circle shadow position-fixed" style="bottom: 2rem; right: 2rem; width: 60px; height: 60px; z-index: 1000;" @onclick="NuevoInquilino">
            <i class="bi bi-person-plus-fill fs-3"></i>
        </button>
    }
</div>

<!-- Bottom Sheet Opciones Inquilino -->
@if (mostrarOpciones && seleccionado != null)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarOpciones"></div>
    <div class="bottom-sheet slide-up">
        <div class="bottom-sheet-header text-center pt-2">
            <div class="bottom-sheet-handle mx-auto bg-secondary rounded-pill mb-3" style="width: 40px; height: 5px;"></div>
            <h6 class="fw-bold text-dark mb-3">@seleccionado.NombreCompleto.ToUpper()</h6>
        </div>
        <div class="list-group list-group-flush">
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="IrAEditar">
                <i class="bi bi-pencil-square text-info fs-5 me-2"></i> Editar
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold text-danger" @onclick="ConfirmarEliminar">
                <i class="bi bi-trash-fill fs-5 me-2"></i> Eliminar Inquilino
            </button>
        </div>
    </div>
}

<!-- Modal Confirmar Eliminar -->
@if (mostrarConfirmarEliminar && seleccionado != null)
{
    <div class="modal-overlay" @onclick="() => mostrarConfirmarEliminar = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-exclamation-triangle fs-3"></i>
        </div>
        <h5 class="fw-bold text-danger">¿Eliminar Inquilino?</h5>
        <p class="text-muted small">Esta acción borrará definitivamente al inquilino y rescindirá sus contratos. No se puede deshacer.</p>
        
        <div class="d-flex gap-3">
            <button class="btn btn-light fw-bold w-50 py-2 rounded-pill" @onclick="() => mostrarConfirmarEliminar = false">CANCELAR</button>
            <button class="btn btn-danger fw-bold w-50 py-2 rounded-pill" @onclick="EliminarInquilino">ELIMINAR</button>
        </div>
    </div>
}

<style>
    .modal-overlay, .bottom-sheet-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .bottom-sheet {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: white; border-radius: 20px 20px 0 0;
        z-index: 1050; padding-bottom: 20px;
    }
    .scale-in { animation: scaleIn 0.3s ease; }
    @@keyframes scaleIn { from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    .slide-up { animation: slideUp 0.3s ease-out forwards; }
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>

@code {
    private List<InquilinoDto> inquilinos = new();
    private bool cargando = true;
    private string errorMessage = "";

    // Bottom Sheet y Modales
    private bool mostrarOpciones = false;
    private InquilinoDto? seleccionado;
    private bool mostrarConfirmarEliminar = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            inquilinos = await Api.GetInquilinosAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoInquilino()
    {
        Nav.NavigateTo("/inquilinos/nuevo");
    }

    private void AbrirOpciones(InquilinoDto inq)
    {
        seleccionado = inq;
        mostrarOpciones = true;
    }

    private void CerrarOpciones()
    {
        mostrarOpciones = false;
        seleccionado = null;
    }

    private void IrAEditar()
    {
        if (seleccionado == null) return;
        var id = seleccionado.Id;
        CerrarOpciones();
        Nav.NavigateTo($"/inquilinos/editar/{id}");
    }

    private void ConfirmarEliminar()
    {
        mostrarOpciones = false;
        mostrarConfirmarEliminar = true;
    }

    private async Task EliminarInquilino()
    {
        if (seleccionado == null) return;
        mostrarConfirmarEliminar = false;
        try
        {
            var exito = await Api.DeleteInquilinoAsync(seleccionado.Id);
            if (exito)
            {
                inquilinos.Remove(seleccionado);
            }
            else
            {
                errorMessage = "No se pudo eliminar el inquilino.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            seleccionado = null;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
