@page "/"
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Globalization
@using RentaFacil.MAUI.Services
@using RentaFacil.MAUI.ViewModels
@using RentaFacil.MAUI.Components.Layout
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <!-- Botón de Menú circular al lado superior izquierdo -->
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2 btn-menu-circle" 
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15); transition: all 0.2s;" 
            @onclick="AbrirMenu"
            aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    
    <h3 class="mb-0 fw-normal text-center flex-grow-1" style="font-size: 1.5rem;">Estado</h3>
    
    <!-- Botón derecho de Búsqueda para mantener simetría -->
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; opacity: 0.85;">
        <i class="bi bi-search" style="font-size: 1.4rem;"></i>
    </button>
</div>

<div class="dashboard-header d-flex justify-content-between align-items-center mb-3">
    <!-- Botón de Fecha -->
    <div class="date-box text-white p-2 text-center rounded shadow-sm" style="width: 130px; background-color: #2a7587; cursor: pointer;" @onclick="AbrirSelectorFecha">
        <span class="d-block fw-bold fs-6">@fechaFiltro.ToString("ddd dd MMM").ToUpper()</span>
        <span class="d-block fw-bold fs-6">@fechaFiltro.Year</span>
    </div>

    <!-- Toggle Pendientes / Pagados -->
    <div class="toggle-box d-flex align-items-center bg-white border rounded-pill p-1 shadow-sm" @onclick="ToggleEstado" style="cursor:pointer; min-width: 140px;">
        @if (mostrarPendientes)
        {
            <div class="text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 40px; height: 40px; background-color: #43a047;">
                <i class="bi bi-emoji-smile-fill fs-4"></i>
            </div>
            <span class="fw-bold px-2 text-muted">Total: @estadoInquilinos.Count(e => !e.HaPagado)</span>
        }
        else
        {
            <div class="text-white rounded-circle d-flex justify-content-center align-items-center ms-auto" style="width: 40px; height: 40px; background-color: #43a047; order: 2;">
                <i class="bi bi-emoji-smile-fill fs-4"></i>
            </div>
            <span class="fw-bold px-2 text-muted" style="order: 1;">Total: @estadoInquilinos.Count(e => e.HaPagado)</span>
        }
    </div>

    <!-- Botón de Ayuda -->
    <button class="btn btn-outline-secondary rounded-circle fw-bold bg-white shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem;" @onclick="() => mostrarLeyenda = true">?</button>
</div>

@if (cargando)
{
    <p class="text-center mt-4"><em>Cargando estado...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger m-3">@errorMessage</div>
}
else
{
    var filtrados = estadoInquilinos.Where(e => mostrarPendientes ? !e.HaPagado : e.HaPagado).ToList();
    
    if (!filtrados.Any())
    {
        <p class="text-center mt-4">No hay inquilinos en esta categoría.</p>
    }
    else
    {
        @foreach (var estado in filtrados)
        {
            <div class="card estado-card mb-3 shadow-sm border-0" @onclick="() => AbrirBottomSheet(estado)" style="border-radius: 15px; border-left: 6px solid @(GetEstadoColor(estado)) !important;">
                <div class="card-body">
                    <h5 class="card-title text-center fw-bold mb-2">@estado.Inquilino.NombreCompleto.ToUpper()</h5>
                    <div class="progress mb-2" style="height: 8px;">
                        <div class="progress-bar" role="progressbar" style="width: @(estado.HaPagado ? "100%" : "0%"); background-color: @GetEstadoColor(estado) !important;"></div>
                    </div>
                    <p class="text-center fw-bold mb-3" style="color: @(estado.HaPagado ? "#43a047" : "#d32f2f"); font-size: 0.85rem;">
                        @(estado.HaPagado ? "PAGO COMPLETADO" : "0% DEL TOTAL PAGADO")
                    </p>

                    <div class="row align-items-center mb-3">
                        <div class="col-6 d-flex align-items-center">
                            <i class="bi bi-eye-fill fs-1 text-dark me-2"></i>
                            <div>
                                <span class="fw-bold d-block">Nº</span>
                                <small class="text-muted">@estado.Unidad?.Nombre</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-white text-center fw-bold rounded px-2 py-1 mb-2" style="background-color: @(estado.HaPagado ? "#43a047" : GetEstadoColor(estado));">
                                @estado.PeriodoActual
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span>Total</span>
                                <span>@MoneyFormatter.Mostrar(estado.Contrato.Monto)</span>
                            </div>
                            <div class="d-flex justify-content-between small text-success">
                                <span>A Cta</span>
                                <span>@(estado.HaPagado ? MoneyFormatter.Mostrar(estado.Contrato.Monto) : MoneyFormatter.Mostrar(0))</span>
                            </div>
                            <div class="d-flex justify-content-between small text-danger fw-bold">
                                <span>Saldo</span>
                                <span>@MoneyFormatter.Mostrar(estado.SaldoPendiente)</span>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <div class="col-5">
                            <div class="d-flex bg-light rounded p-2 align-items-center mb-1">
                                <i class="bi bi-calendar-event me-2" style="color: @GetEstadoColor(estado) !important;"></i>
                                <div class="w-100 d-flex justify-content-between">
                                    <small class="fw-bold">F/PAGO:</small>
                                    <small>@estado.Contrato.DiaPago @(fechaFiltro.ToString("MMM"))</small>
                                </div>
                            </div>
                            <div class="d-flex bg-light rounded p-2 align-items-center">
                                <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                                <div class="w-100 d-flex justify-content-between">
                                    <small class="fw-bold">SERV:</small>
                                    <small>0.00</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-7">
                            <button class="btn w-100 fw-bold text-white shadow-sm" style="background-color: @(estado.RequiereFactura ? "#2e7d32" : "#c62828"); border-radius: 10px; pointer-events: none;">
                                @(estado.RequiereFactura ? "FACTURADO" : "SIN FACTURA")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}

<!-- Selector de Fecha (Calendario Pop-up) -->
@if (mostrarSelectorFecha)
{
    <div class="modal-overlay" @onclick="() => mostrarSelectorFecha = false"></div>
    <div class="modal-custom scale-in p-0 overflow-hidden" style="max-width: 350px;">
        <!-- Header del Modal -->
        <div class="p-3 text-white" style="background-color: #38a3d1;">
            <p class="mb-1">@fechaSeleccionada.ToString("MMM yyyy")</p>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0 fw-normal">@fechaSeleccionada.Year</h1>
                <div>
                    <i class="bi bi-chevron-up fs-5 me-2" @onclick="() => CambiarAnio(1)" style="cursor:pointer"></i>
                    <i class="bi bi-chevron-down fs-5" @onclick="() => CambiarAnio(-1)" style="cursor:pointer"></i>
                </div>
            </div>
        </div>
        <!-- Body del Modal (Meses) -->
        <div class="p-3 bg-white text-center">
            <div class="row g-3">
                @for (int i = 1; i <= 12; i++)
                {
                    var mes = i;
                    var nombreMes = new DateTime(fechaSeleccionada.Year, mes, 1).ToString("MMM");
                    <div class="col-3">
                        @if (fechaSeleccionada.Month == mes)
                        {
                            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto text-dark" style="width: 50px; height: 50px; background-color: #8be1ce; cursor: pointer;" @onclick="() => SeleccionarMes(mes)">
                                @nombreMes
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto" style="width: 50px; height: 50px; color: #38a3d1; cursor: pointer;" @onclick="() => SeleccionarMes(mes)">
                                @nombreMes
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-link text-info text-decoration-none fw-bold me-2" @onclick="() => mostrarSelectorFecha = false">Cancelar</button>
                <button class="btn btn-link text-info text-decoration-none fw-bold" @onclick="AplicarFecha">ACEPTAR</button>
            </div>
        </div>
    </div>
}

<!-- Modal Leyenda de Colores -->
@if (mostrarLeyenda)
{
    <div class="modal-overlay" @onclick="() => mostrarLeyenda = false"></div>
    <div class="modal-custom scale-in p-4" style="max-width: 400px; border-radius: 15px;">
        <h4 class="fw-bold mb-3 text-center" style="color: #2a7587;">Leyenda de Colores</h4>
        <p class="text-muted text-center mb-4 small">Código de colores para el estado de los pagos y facturación.</p>
        
        <div class="d-flex flex-column gap-3 mb-4 text-start">
            <div class="d-flex align-items-center">
                <span class="rounded-circle me-3" style="width: 20px; height: 20px; background-color: #43a047; display: inline-block;"></span>
                <div>
                    <strong class="text-dark">Verde (Completado)</strong>
                    <span class="text-muted d-block small">Pago del inquilino registrado para este mes.</span>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <span class="rounded-circle me-3" style="width: 20px; height: 20px; background-color: #0288d1; display: inline-block;"></span>
                <div>
                    <strong class="text-dark">Azul (Futuro)</strong>
                    <span class="text-muted d-block small">El pago aún no ha vencido en el mes seleccionado.</span>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <span class="rounded-circle me-3" style="width: 20px; height: 20px; background-color: #fdd835; display: inline-block;"></span>
                <div>
                    <strong class="text-dark">Amarillo (Hoy)</strong>
                    <span class="text-muted d-block small">La fecha de pago programada es hoy.</span>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <span class="rounded-circle me-3" style="width: 20px; height: 20px; background-color: #e53935; display: inline-block;"></span>
                <div>
                    <strong class="text-dark">Rojo (Vencido)</strong>
                    <span class="text-muted d-block small">La fecha límite de pago programada ya pasó.</span>
                </div>
            </div>
            <hr class="my-2" />
            <div class="d-flex align-items-center">
                <span class="badge me-3 py-2 px-3 fw-bold text-white" style="width: 110px; background-color: #2e7d32;">FACTURADO</span>
                <span class="text-muted small">El recibo / factura fue entregado.</span>
            </div>
            <div class="d-flex align-items-center">
                <span class="badge me-3 py-2 px-3 fw-bold text-white" style="width: 110px; background-color: #c62828;">SIN FACTURA</span>
                <span class="text-muted small">Pendiente de facturar o entregar.</span>
            </div>
        </div>
        
        <button class="btn w-100 text-white fw-bold py-2 rounded-pill shadow-sm" style="background-color: #2a7587;" @onclick="() => mostrarLeyenda = false">
            Entendido
        </button>
    </div>
}

<!-- Bottom Sheet (Impago) -->
@if (bottomSheetAbierto && bottomSheetEstado != null && !bottomSheetEstado.HaPagado)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarBottomSheet"></div>
    <div class="bottom-sheet slide-up">
        <div class="bottom-sheet-header text-center pt-2">
            <div class="bottom-sheet-handle mx-auto bg-secondary rounded-pill mb-3" style="width: 40px; height: 5px;"></div>
        </div>
        <div class="list-group list-group-flush">
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="GoToRealizarPago">
                <i class="bi bi-currency-dollar text-success fs-5 me-2"></i> Realizar pago
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="AbrirRecordatorio">
                <i class="bi bi-bell text-warning fs-5 me-2"></i> Recordatorio
            </button>
            @if (bottomSheetEstado.PagoActual != null)
            {
                <!-- Solo se puede marcar Facturado sobre un Pago ya existente (el flag vive en la tabla Pagos) -->
                <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="ToggleFactura">
                    <i class="bi bi-receipt text-info fs-5 me-2"></i> Entregar factura
                </button>
            }
        </div>
    </div>
}

<!-- Bottom Sheet (Pagado) -->
@if (bottomSheetAbierto && bottomSheetEstado != null && bottomSheetEstado.HaPagado)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarBottomSheet"></div>
    <div class="bottom-sheet slide-up">
        <div class="bottom-sheet-header text-center pt-2">
            <div class="bottom-sheet-handle mx-auto bg-secondary rounded-pill mb-3" style="width: 40px; height: 5px;"></div>
        </div>
        <div class="list-group list-group-flush">
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="GoToDetallesPagos">
                <i class="bi bi-list-ul text-primary fs-5 me-2"></i> Detalles de Pagos
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="AbrirFormatoRecibo">
                <i class="bi bi-file-earmark-pdf text-danger fs-5 me-2"></i> Recibo PDF
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="AbrirRecordatorio">
                <i class="bi bi-bell text-warning fs-5 me-2"></i> Recordatorio
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="ToggleFactura">
                <i class="bi bi-receipt-cutoff text-secondary fs-5 me-2"></i> Cancelar factura
            </button>
        </div>
    </div>
}

<!-- Bottom Sheet Formato Recibo -->
@if (showFormatoRecibo)
{
    <div class="bottom-sheet-overlay" @onclick="() => showFormatoRecibo = false"></div>
    <div class="bottom-sheet slide-up text-center p-3">
        <h5 class="fw-bold">Formato de Recibo</h5>
        <p class="text-muted small">Documentos PDF</p>
        
        <div class="d-flex justify-content-center gap-3 mb-4">
            <div class="border rounded p-3 @(reciboEsTicket ? "border-primary bg-light" : "")" @onclick="() => reciboEsTicket = true">
                <i class="bi bi-receipt fs-1 text-primary"></i>
                <div class="fw-bold mt-2">Ticket</div>
            </div>
            <div class="border rounded p-3 @(!reciboEsTicket ? "border-primary bg-light" : "")" @onclick="() => reciboEsTicket = false">
                <i class="bi bi-file-earmark-text fs-1 text-primary"></i>
                <div class="fw-bold mt-2">Carta</div>
            </div>
        </div>

        <p class="text-muted small mb-2">Compartir digital</p>
        <button class="btn btn-outline-success rounded-circle p-3 shadow-sm mb-3" @onclick="CompartirWhatsApp">
            <i class="bi bi-whatsapp fs-3"></i>
        </button>
    </div>
}

<!-- Bottom Sheet Recordatorio -->
@if (showRecordatorio && bottomSheetEstado != null)
{
    <div class="bottom-sheet-overlay" @onclick="() => showRecordatorio = false"></div>
    <div class="bottom-sheet slide-up p-4">
        <div class="text-center mb-3">
            <i class="bi bi-person-circle fs-1 text-secondary"></i>
            <h5 class="fw-bold mt-2">@bottomSheetEstado.Inquilino.NombreCompleto</h5>
        </div>
        @if (!string.IsNullOrEmpty(errorRecordatorio))
        {
            <div class="alert alert-danger small">@errorRecordatorio</div>
        }
        <div class="mb-3">
            <label class="form-label fw-bold">Detalle del aviso:</label>
            <textarea class="form-control" rows="3" placeholder="Escribe tu recordatorio..." @bind="recordatorioDetalle"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Programación:</label>
            <input type="datetime-local" class="form-control" @bind="recordatorioFecha" />
        </div>
        <button class="btn btn-primary w-100 fw-bold" @onclick="GuardarRecordatorio">Guardar Recordatorio</button>
    </div>
}

<style>
    .bottom-sheet-overlay, .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
    }
    .bottom-sheet {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: white;
        border-radius: 20px 20px 0 0;
        z-index: 1050;
        padding-bottom: 20px;
    }
    .modal-custom {
        position: fixed;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        background: white;
        border-radius: 10px;
        z-index: 1050;
    }
    .slide-up {
        animation: slideUp 0.3s ease-out forwards;
    }
    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }
    .scale-in {
        animation: scaleIn 0.2s ease-out forwards;
    }
    @@keyframes scaleIn {
        from { transform: translate(-50%, -45%) scale(0.95); opacity: 0; }
        to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }
    .btn-menu-circle:hover {
        background-color: rgba(255, 255, 255, 0.3) !important;
        transform: scale(1.05);
    }
    .btn-menu-circle:active {
        transform: scale(0.95);
    }
</style>

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private List<EstadoInquilinoViewModel> estadoInquilinos = new();
    private bool cargando = true;
    private bool mostrarPendientes = true;

    private bool bottomSheetAbierto = false;
    private EstadoInquilinoViewModel? bottomSheetEstado;

    private bool showFormatoRecibo = false;
    private bool reciboEsTicket = true;
    private bool showRecordatorio = false;
    private string recordatorioDetalle = "";
    private DateTime recordatorioFecha = DateTime.Now;
    private string errorRecordatorio = "";

    // Calendario Variables
    private bool mostrarSelectorFecha = false;
    private DateTime fechaFiltro = DateTime.Today;
    private DateTime fechaSeleccionada = DateTime.Today;
    private bool mostrarLeyenda = false;

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoInquilinosAsync();
    }

    private async Task CargarEstadoInquilinosAsync()
    {
        cargando = true;
        errorMessage = "";
        StateHasChanged();
        try
        {
            var inmuebles = await Api.GetInmueblesAsync();
            if (!inmuebles.Any())
            {
                Nav.NavigateTo("/inmuebles");
                return;
            }

            var inquilinos = await Api.GetInquilinosAsync();
            var contratos = await Api.GetContratosAsync();
            var pagos = await Api.GetPagosAsync();
            var unidades = await Api.GetUnidadesAsync();

            estadoInquilinos.Clear();

            foreach (var c in contratos.Where(x => x.Activo))
            {
                var inq = inquilinos.FirstOrDefault(i => i.Id == c.InquilinoId);
                var uni = unidades.FirstOrDefault(u => u.Id == c.UnidadId);
                if (inq != null && uni != null)
                {
                    var pagoMes = pagos.FirstOrDefault(p => p.ContratoId == c.Id && p.FechaPago.Month == fechaFiltro.Month && p.FechaPago.Year == fechaFiltro.Year);
                    
                    estadoInquilinos.Add(new EstadoInquilinoViewModel
                    {
                        Inquilino = inq,
                        Contrato = c,
                        Unidad = uni,
                        PagoActual = pagoMes,
                        RequiereFactura = pagoMes?.Facturado ?? false,
                        FechaFiltro = fechaFiltro
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void AbrirMenu()
    {
        if (Layout != null)
        {
            Layout.ToggleSidebar();
        }
    }

    private void ToggleEstado()
    {
        mostrarPendientes = !mostrarPendientes;
    }

    // Selector de Fecha Logic
    private void AbrirSelectorFecha()
    {
        fechaSeleccionada = fechaFiltro;
        mostrarSelectorFecha = true;
    }

    private void CambiarAnio(int delta)
    {
        fechaSeleccionada = fechaSeleccionada.AddYears(delta);
    }

    private void SeleccionarMes(int mes)
    {
        fechaSeleccionada = new DateTime(fechaSeleccionada.Year, mes, 1);
    }

    private async Task AplicarFecha()
    {
        fechaFiltro = fechaSeleccionada;
        mostrarSelectorFecha = false;
        await CargarEstadoInquilinosAsync();
    }

    // Resto de la lógica (BottomSheet, Compartir)
    private void AbrirBottomSheet(EstadoInquilinoViewModel estado)
    {
        bottomSheetEstado = estado;
        bottomSheetAbierto = true;
    }

    private void CerrarBottomSheet()
    {
        bottomSheetAbierto = false;
        bottomSheetEstado = null;
    }

    private void GoToRealizarPago()
    {
        if (bottomSheetEstado != null)
        {
            Nav.NavigateTo($"/crearpago/{bottomSheetEstado.Contrato.Id}");
        }
    }

    private void GoToDetallesPagos()
    {
        if (bottomSheetEstado != null)
        {
            Nav.NavigateTo($"/pagos/detalle/{bottomSheetEstado.Contrato.Id}");
        }
    }

    private void AbrirFormatoRecibo()
    {
        CerrarBottomSheet();
        showFormatoRecibo = true;
    }

    private async Task CompartirWhatsApp()
    {
        if (bottomSheetEstado?.PagoActual == null) return;
        showFormatoRecibo = false;
        
        try
        {
            var formatoStr = "ticket";
            var response = await Api.HttpClient.GetAsync($"api/pagos/{bottomSheetEstado.PagoActual.Id}/recibo/{formatoStr}");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"Recibo_Ticket_RentaFacil_{bottomSheetEstado.PagoActual.Periodo}.pdf";
                var tempPath = Path.Combine(Microsoft.Maui.Storage.FileSystem.CacheDirectory, fileName);
                await File.WriteAllBytesAsync(tempPath, bytes);

                await Microsoft.Maui.ApplicationModel.DataTransfer.Share.RequestAsync(new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFileRequest
                {
                    Title = "Compartir Recibo de Pago por WhatsApp",
                    File = new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFile(tempPath)
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al compartir: {ex.Message}");
        }
    }

    private void AbrirRecordatorio()
    {
        recordatorioDetalle = "";
        recordatorioFecha = DateTime.Now;
        errorRecordatorio = "";
        showRecordatorio = true;
    }

    private async Task GuardarRecordatorio()
    {
        if (bottomSheetEstado == null || string.IsNullOrWhiteSpace(recordatorioDetalle)) return;

        try
        {
            var dto = new CrearRecordatorioDto(bottomSheetEstado.Inquilino.Id, bottomSheetEstado.Contrato.Id, recordatorioDetalle, recordatorioFecha);
            var creado = await Api.CrearRecordatorioAsync(dto);
            if (creado == null)
            {
                errorRecordatorio = "No se pudo guardar el recordatorio.";
                return;
            }
            showRecordatorio = false;
            CerrarBottomSheet();
        }
        catch (Exception ex)
        {
            errorRecordatorio = $"Error al guardar: {ex.Message}";
        }
    }

    private async Task ToggleFactura()
    {
        if (bottomSheetEstado?.PagoActual == null) { CerrarBottomSheet(); return; }

        var pago = bottomSheetEstado.PagoActual;
        var nuevoValor = !bottomSheetEstado.RequiereFactura;
        var dto = new CrearPagoDto(pago.ContratoId, pago.TotalMonto, pago.ACuenta, pago.Servicios, pago.FechaPago, pago.Periodo, nuevoValor);
        var exito = await Api.ActualizarPagoAsync(pago.Id, dto);
        if (exito)
        {
            bottomSheetEstado.PagoActual = pago with { Facturado = nuevoValor };
            bottomSheetEstado.RequiereFactura = nuevoValor;
        }
        CerrarBottomSheet();
    }

    private string GetEstadoColor(EstadoInquilinoViewModel estado)
    {
        if (estado.HaPagado) return "#43a047"; // Verde
        
        var dueDay = Math.Min(estado.Contrato.DiaPago, DateTime.DaysInMonth(fechaFiltro.Year, fechaFiltro.Month));
        var dueDate = new DateTime(fechaFiltro.Year, fechaFiltro.Month, dueDay);
        
        if (dueDate.Date == DateTime.Today) return "#fdd835"; // Amarillo
        if (dueDate.Date < DateTime.Today) return "#e53935"; // Rojo
        return "#0288d1"; // Azul (fecha de pago próxima)
    }
}
