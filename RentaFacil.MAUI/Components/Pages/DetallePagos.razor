@page "/pagos/detalle/{ContratoId:int}"
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Globalization
@using RentaFacil.MAUI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem;" @onclick="GoBack">
        <i class="bi bi-arrow-left fs-4"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Detalles de Pagos</h3>
    <div style="width: 2.5rem; height: 2.5rem;"></div>
</div>

@if (pagos == null)
{
    <p class="text-center mt-4"><em>Cargando historial de pagos...</em></p>
}
else if (!pagos.Any())
{
    <p class="text-center mt-4 text-muted">Aún no se han registrado pagos para este inquilino.</p>
}
else
{
    <div class="list-group list-group-flush border rounded-4 shadow-sm">
        @foreach (var pago in pagos.OrderByDescending(p => p.FechaPago))
        {
            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3 d-flex justify-content-center align-items-center" style="width: 45px; height: 45px;">
                        <i class="bi bi-check-lg fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Periodo: @pago.Periodo</h6>
                        <small class="text-muted">@pago.FechaPago.ToString("dd MMM yyyy - HH:mm")</small>
                    </div>
                </div>
                <div class="text-end">
                    <span class="fw-bold d-block text-primary">@MoneyFormatter.Mostrar(pago.ACuenta)</span>
                    @if (pago.Facturado)
                    {
                        <span class="badge bg-success small">Facturado</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary small">Sin Factura</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int ContratoId { get; set; }
    private List<PagoDto>? pagos;

    protected override async Task OnInitializedAsync()
    {
        var todosPagos = await Api.GetPagosAsync();
        pagos = todosPagos.Where(p => p.ContratoId == ContratoId).ToList();
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
