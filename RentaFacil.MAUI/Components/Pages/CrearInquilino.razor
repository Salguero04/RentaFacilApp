@page "/inquilinos/nuevo"
@page "/inquilinos/editar/{Id:int}"
@using RentaFacil.Shared.Models
@using RentaFacil.MAUI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem;" @onclick="GoBack">
        <i class="bi bi-arrow-left fs-4"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">@(Id.HasValue ? "Editar Inquilino" : "Nuevo Inquilino")</h3>
    <div style="width: 2.5rem; height: 2.5rem;"></div>
</div>

<div class="bg-white rounded-top-4 p-4 shadow-sm" style="min-height: 80vh;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando datos del inquilino...</em></p>
    }
    else
    {
        <EditForm Model="this" OnValidSubmit="Guardar">
            <div class="mb-4 text-center">
                <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-3 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px;">
                    <i class="bi bi-person-fill fs-2"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Nombre Completo</label>
                <InputText @bind-Value="nombreCompleto" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Ej: Juan Pérez" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Identificación (DNI / CI / RUC)</label>
                <InputText @bind-Value="identificacion" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Ej: 1234567-8" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Número de Teléfono</label>
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone-fill"></i></span>
                    <InputText @bind-Value="telefono" class="form-control rounded-end-3" placeholder="Ej: +591 70000000" />
                </div>
            </div>

            <div class="d-flex flex-column gap-2 mt-5">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i> Guardar Inquilino
                </button>
                <button type="button" class="btn btn-light btn-lg rounded-pill py-3 fw-bold border" @onclick="GoBack">
                    Cancelar
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private string nombreCompleto = "";
    private string identificacion = "";
    private string telefono = "";
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            cargando = true;
            try
            {
                var inq = await Api.GetInquilinoByIdAsync(Id.Value);
                if (inq != null)
                {
                    nombreCompleto = inq.NombreCompleto;
                    identificacion = inq.Identificacion;
                    telefono = inq.Telefono ?? "";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al cargar inquilino: {ex.Message}");
            }
            finally
            {
                cargando = false;
            }
        }
    }

    private async Task Guardar()
    {
        var dto = new CrearInquilinoDto(nombreCompleto, identificacion, telefono, null);
        try
        {
            if (Id.HasValue)
            {
                await Api.UpdateInquilinoAsync(Id.Value, dto);
            }
            else
            {
                await Api.CrearInquilinoAsync(dto);
            }
            Nav.NavigateTo("/inquilinos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/inquilinos");
    }
}
