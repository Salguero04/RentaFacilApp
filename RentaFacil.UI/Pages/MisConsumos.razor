@page "/mi/consumos"
@using RentaFacil.Shared.Enums
@inject ApiClient Api

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Mis Consumos</h3>
    <div style="width: 2.5rem; height: 2.5rem;"></div>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh; position: relative;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-1">@errorMessage</div>
    }
    else if (!consumos.Any())
    {
        <div class="text-center text-muted mt-4">
            <i class="bi bi-droplet fs-1 d-block mb-3"></i>
            <p>No tienes medidores vinculados.</p>
        </div>
    }
    else
    {
        @foreach (var c in consumos)
        {
            <div class="card shadow-sm border-0 mb-3 rounded-4">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                        <i class="bi @IconoServicio(c.Tipo) fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-0">@c.NombreMedidor</h6>
                        <small class="text-muted d-block">@EtiquetaTipo(c.Tipo) · @EtiquetaMetodoCobro(c.MetodoCobro)</small>
                        <div class="d-flex justify-content-between small mt-1">
                            <span class="text-muted">Lectura anterior</span>
                            <span>@c.LecturaAnterior</span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Lectura actual</span>
                            <span>@c.LecturaActual</span>
                        </div>
                        <div class="d-flex justify-content-between small fw-bold text-primary">
                            <span>Consumo</span>
                            <span>@(c.LecturaActual - c.LecturaAnterior)</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<MiConsumoDto> consumos = new();
    private bool cargando = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            consumos = await Api.GetMisConsumosAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string EtiquetaTipo(TipoServicio t) => t switch
    {
        TipoServicio.Agua => "Agua",
        TipoServicio.Electricidad => "Electricidad",
        TipoServicio.Gas => "Gas",
        _ => "Otro"
    };

    private static string IconoServicio(TipoServicio t) => t switch
    {
        TipoServicio.Agua => "bi-droplet-fill",
        TipoServicio.Electricidad => "bi-lightning-charge-fill",
        TipoServicio.Gas => "bi-fire",
        _ => "bi-gear-fill"
    };

    private static string EtiquetaMetodoCobro(MetodoCobroInquilino m) => m switch
    {
        MetodoCobroInquilino.Tarifa => "Por tarifa",
        MetodoCobroInquilino.Prorrateo => "Prorrateo de factura",
        MetodoCobroInquilino.Manual => "Monto fijo",
        _ => m.ToString()
    };

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
