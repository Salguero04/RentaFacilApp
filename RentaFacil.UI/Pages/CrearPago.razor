@page "/crearpago/{ContratoId:int}"
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Enums
@using RentaFacil.Shared.Globalization
@using RentaFacil.UI.Services
@using RentaFacil.UI.ViewModels
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Realizar Pago</h3>
    <div style="width: 2.5rem; height: 2.5rem;"></div>
</div>

@if (estado == null)
{
    <p class="text-center mt-4"><em>Cargando datos del inquilino...</em></p>
}
else
{
    <div class="card estado-card mb-4 shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title text-center fw-bold mb-3">@estado.Inquilino.NombreCompleto.ToUpper()</h5>
            <div class="progress mb-3" style="height: 5px;">
                <div class="progress-bar bg-light" role="progressbar" style="width: 100%"></div>
            </div>
            <p class="text-center text-muted small fw-bold mb-3">0% DEL TOTAL PAGADO</p>

            <div class="row align-items-center mb-3">
                <div class="col-6 d-flex align-items-center">
                    <i class="bi bi-person-fill fs-1 text-secondary me-2"></i>
                    <div>
                        <span class="fw-bold d-block">Nº</span>
                        <small class="text-muted">@estado.Unidad?.Nombre</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-warning text-white text-center fw-bold rounded px-2 py-1 mb-2">
                        @estado.PeriodoActual
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span>Total</span>
                        <span>@MoneyFormatter.Mostrar(TotalAPagar)</span>
                    </div>
                    <div class="d-flex justify-content-between small text-success">
                        <span>A Cta</span>
                        <span>@MoneyFormatter.Mostrar(montoAPagar)</span>
                    </div>
                    <div class="d-flex justify-content-between small text-danger fw-bold">
                        <span>Saldo</span>
                        <span>@MoneyFormatter.Mostrar(Math.Max(0, TotalAPagar - montoAPagar))</span>
                    </div>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-5">
                    <div class="d-flex bg-light rounded p-2 align-items-center mb-1">
                        <i class="bi bi-calendar-event text-primary me-2"></i>
                        <div class="w-100 d-flex justify-content-between">
                            <small class="fw-bold">F/PAGO:</small>
                            <small>@estado.Contrato.DiaPago @(DateTime.Today.ToString("MMM"))</small>
                        </div>
                    </div>
                    <div class="d-flex bg-light rounded p-2 align-items-center">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                        <div class="w-100 d-flex justify-content-between">
                            <small class="fw-bold">SERV:</small>
                            <small>@MoneyFormatter.Mostrar(TotalServicios)</small>
                        </div>
                    </div>
                </div>
                <div class="col-7">
                    <button class="btn btn-info text-white w-100 fw-bold">SIN FACTURA</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border rounded-4 mb-3 shadow-sm">
        <div class="card-body p-3">
            <h6 class="fw-bold text-secondary mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">SERVICIOS DEL CONTRATO</h6>
            @if (!cobrosServicios.Any())
            {
                <p class="text-muted small mb-2">Sin medidores vinculados a este contrato. <span class="d-block">Vincula al inquilino a un medidor en la sección Medidores.</span></p>
            }
            else
            {
                @foreach (var c in cobrosServicios)
                {
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi @IconoServicio(c.Tipo) fs-5 me-2 text-info"></i>
                        <div class="flex-grow-1"><span class="fw-bold">@EtiquetaTipo(c.Tipo)</span></div>
                        <span class="fw-bold text-info">@MoneyFormatter.Mostrar(c.Monto)</span>
                    </div>
                }
            }
            <hr class="my-2 opacity-25" />
            <div class="d-flex justify-content-between fw-bold">
                <span>Renta</span>
                <span>@MoneyFormatter.Mostrar(estado.Contrato.Monto)</span>
            </div>
            <div class="d-flex justify-content-between fw-bold">
                <span>Servicios</span>
                <span class="text-info">@MoneyFormatter.Mostrar(TotalServicios)</span>
            </div>
            <div class="d-flex justify-content-between fw-bold fs-5 mt-1">
                <span>Total a pagar</span>
                <span class="text-primary">@MoneyFormatter.Mostrar(TotalAPagar)</span>
            </div>
        </div>
    </div>

    <!-- Formulario de Pago -->
    <div class="card border rounded-4 mb-3 shadow-sm">
        <div class="card-body position-relative pt-4">
            <span class="position-absolute top-0 start-0 ms-3 mt-n2 bg-white px-2 small text-muted">Monto recibido / A cuenta (USD)</span>
            <div class="d-flex align-items-center">
                <i class="bi bi-cash-stack fs-3 me-3 text-secondary"></i>
                <input type="number" class="form-control border-0 text-primary fw-bold text-end fs-4" @bind="montoAPagar" step="0.01" />
            </div>
            
            <hr class="text-muted opacity-25 my-3" />

            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-file-earmark-text fs-4 me-3 text-secondary"></i>
                    <span class="fw-bold text-secondary">Entregar Factura</span>
                </div>
                <div class="form-check form-switch fs-4 mb-0">
                    <input class="form-check-input" type="checkbox" @bind="entregarFactura">
                </div>
            </div>
        </div>
    </div>

    <div class="card border rounded-4 mb-4 shadow-sm">
        <div class="card-body d-flex align-items-center">
            <i class="bi bi-pencil-square fs-4 me-3 text-secondary"></i>
            <input type="text" class="form-control border-0 bg-transparent text-secondary" placeholder="Observaciones internas" @bind="observaciones" />
        </div>
    </div>

    <div class="row gx-3">
        <div class="col-5">
            <button class="btn btn-outline-info w-100 py-3 fw-bold rounded-pill" @onclick="GoBack">Cerrar</button>
        </div>
        <div class="col-7">
            <button class="btn btn-info text-white w-100 py-3 fw-bold rounded-pill shadow" @onclick="GuardarPago">GUARDAR PAGO</button>
        </div>
    </div>
}

<!-- Modal de Confirmación -->
@if (mostrarModalConfirmacion)
{
    <div class="modal-overlay"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 70px; height: 70px;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        <h4 class="fw-bold text-success mb-2">Pago Realizado</h4>
        <p class="text-muted mb-4">El pago se ha registrado correctamente en el sistema.</p>
        
        <div class="d-grid gap-2">
            <button class="btn btn-outline-secondary py-2 fw-bold rounded-pill" @onclick="GoBack">Cerrar</button>
            <button class="btn btn-success py-2 fw-bold rounded-pill" @onclick="VerRecibo">Ver recibo</button>
        </div>
    </div>
}

<style>
    .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 350px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .scale-in { animation: scaleIn 0.3s ease; }
    @@keyframes scaleIn { from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    .mt-n2 { margin-top: -0.5rem !important; }
</style>

@code {
    [Parameter] public int ContratoId { get; set; }
    
    private EstadoInquilinoViewModel? estado;
    private decimal montoAPagar;
    private bool entregarFactura;
    private string observaciones = "";
    private bool mostrarModalConfirmacion = false;
    private PagoDto? pagoGuardado;

    // ── Servicios del contrato: calculados desde los medidores vinculados ──
    private List<DetalleServicioPagoDto> cobrosServicios = new();
    private decimal TotalServicios => cobrosServicios.Sum(c => c.Monto);
    private decimal TotalAPagar => (estado?.Contrato.Monto ?? 0) + TotalServicios;

    private static string EtiquetaTipo(TipoServicio t) => t switch { TipoServicio.Agua => "Agua", TipoServicio.Electricidad => "Electricidad", TipoServicio.Gas => "Gas", _ => "Otro" };
    private static string IconoServicio(TipoServicio t) => t switch { TipoServicio.Agua => "bi-droplet-fill", TipoServicio.Electricidad => "bi-lightning-charge-fill", TipoServicio.Gas => "bi-fire", _ => "bi-gear-fill" };

    protected override async Task OnInitializedAsync()
    {
        var contratos = await Api.GetContratosAsync();
        var c = contratos.FirstOrDefault(x => x.Id == ContratoId);
        if (c == null) { GoBack(); return; }

        var inquilinos = await Api.GetInquilinosAsync();
        var unidades = await Api.GetUnidadesAsync();
        var inq = inquilinos.FirstOrDefault(i => i.Id == c.InquilinoId);
        var uni = unidades.FirstOrDefault(u => u.Id == c.UnidadId);

        if (inq != null && uni != null)
        {
            estado = new EstadoInquilinoViewModel
            {
                Inquilino = inq,
                Contrato = c,
                Unidad = uni,
                PagoActual = null
            };

            // Cobros de servicios calculados desde los medidores vinculados al contrato (mes actual).
            var hoy = DateTime.Today;
            cobrosServicios = await Api.GetCobrosContratoAsync(ContratoId, hoy.Month, hoy.Year);

            montoAPagar = TotalAPagar;
        }
    }

    private async Task GuardarPago()
    {
        if (estado == null) return;

        var detalles = cobrosServicios.Where(c => c.Monto != 0).ToList();

        var dto = new CrearPagoDto(ContratoId, estado.Contrato.Monto, montoAPagar, TotalServicios, DateTime.Now, estado.PeriodoActual, entregarFactura, detalles);
        pagoGuardado = await Api.CrearPagoAsync(dto);
        mostrarModalConfirmacion = true;
    }

    private void VerRecibo()
    {
        // Descargar/Ver el recibo directamente en ticket
        if (pagoGuardado != null)
        {
            Nav.NavigateTo($"/api/pagos/{pagoGuardado.Id}/recibo?formato=ticket", forceLoad: true);
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
