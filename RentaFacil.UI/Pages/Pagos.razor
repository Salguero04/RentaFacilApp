@page "/pagos"
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Globalization
@using RentaFacil.UI.Services
@inject ApiClient Api
@inject IDispositivoServicio Dispositivo
@inject SignalRClient Realtime
@implements IDisposable

<h1>Estado de Pagos</h1>

<div class="mb-3">
    <a href="/pagos/nuevo" class="btn btn-primary">Registrar Pago</a>
</div>

@if (pagos == null)
{
    <p><em>Cargando...</em></p>
}
else if (!pagos.Any())
{
    <p>No hay pagos registrados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Contrato</th>
                <th>Periodo</th>
                <th>Monto Total</th>
                <th>A Cuenta</th>
                <th>Saldo</th>
                <th>Estado</th>
                <th>Factura</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pagos)
            {
                <tr style="@(p.Completado ? "background-color: #d4edda;" : "background-color: #f8d7da;")">
                    <td>@p.Id</td>
                    <td>@p.ContratoId</td>
                    <td>@p.Periodo</td>
                    <td>@MoneyFormatter.Mostrar(p.TotalMonto)</td>
                    <td>@MoneyFormatter.Mostrar(p.ACuenta)</td>
                    <td>@MoneyFormatter.Mostrar(Math.Max(0, (p.TotalMonto + p.Servicios) - p.ACuenta))</td>
                    <td>@(p.Completado ? "COMPLETO" : "PENDIENTE")</td>
                    <td>
                        @if (p.Facturado)
                        {
                            <span class="badge bg-success">Facturado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin Factura</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => DescargarRecibo(p.Id, "ticket")'>
                            <i class="bi bi-receipt"></i> Ticket
                        </button>
                        <button class="btn btn-sm btn-primary" @onclick='() => DescargarRecibo(p.Id, "carta")'>
                            <i class="bi bi-file-earmark-pdf"></i> Carta
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PagoDto>? pagos;
    protected override async Task OnInitializedAsync()
    {
        pagos = await Api.GetPagosAsync();

        // Tiempo real: si otro cliente cambia un Pago, recargamos la lista.
        Realtime.CambioDatos += OnCambioDatos;
        await Realtime.IniciarAsync();
    }

    private async void OnCambioDatos(string entidad, int usuarioId, string accion)
    {
        if (entidad != "Pago") return;

        // El evento llega en un hilo de fondo: hay que volver al hilo de UI.
        // El refresco es best-effort: si falla, lo tragamos para no tumbar el renderer.
        try
        {
            await InvokeAsync(async () =>
            {
                pagos = await Api.GetPagosAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Pagos] No se pudo refrescar la lista en tiempo real: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Solo desuscribimos el handler; la conexión vive a nivel DI y la
        // reutilizan otras páginas, así que NO la cerramos aquí.
        Realtime.CambioDatos -= OnCambioDatos;
    }

    private async Task DescargarRecibo(int pagoId, string formato)
    {
        // Descargamos el PDF con el HttpClient autenticado (lleva el Bearer token);
        // luego cada plataforma lo guarda/comparte a su manera (MAUI: Share, Web: descarga).
        var response = await Api.HttpClient.GetAsync($"api/pagos/{pagoId}/recibo/{formato}");
        if (!response.IsSuccessStatusCode) return;

        var bytes = await response.Content.ReadAsByteArrayAsync();
        var nombre = $"Recibo_{formato}_RentaFacil_{pagoId}.pdf";
        await Dispositivo.GuardarArchivoAsync(bytes, nombre, "Recibo de Pago");
    }
}
