@page "/inmuebles"
@using RentaFacil.Shared.Models
@using RentaFacil.UI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Mis Inmuebles</h3>
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; opacity: 0.85;">
        <i class="bi bi-search" style="font-size: 1.4rem;"></i>
    </button>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando inmuebles...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else
    {
        <div class="text-center mb-4 mt-2">
            <span class="bg-primary bg-opacity-10 text-primary fw-bold px-4 py-2 rounded-pill">Total: @inmuebles.Count Inmuebles</span>
        </div>

        @foreach (var inv in inmuebles)
        {
            <div class="card shadow-sm border-0 mb-3 rounded-4" @onclick="() => AbrirOpciones(inv)" style="cursor: pointer; transition: all 0.2s;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                            <i class="bi @(inv.Tipo == RentaFacil.Shared.Enums.TipoInmueble.Unico ? "bi-house-fill" : "bi-building") fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-0">@inv.Nombre.ToUpper()</h5>
                            <small class="text-muted">@inv.Direccion</small>
                        </div>
                        <i class="bi bi-three-dots-vertical fs-5 text-muted"></i>
                    </div>
                    <hr class="text-muted opacity-25" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@inv.Tipo</span>
                        <span class="text-secondary fw-bold small">Ver detalles</span>
                    </div>
                </div>
            </div>
        }

        <div class="position-fixed bottom-0 end-0 p-4" style="z-index: 999;">
            <button class="btn btn-primary btn-lg rounded-pill px-4 shadow" @onclick="AbrirModal">
                <i class="bi bi-plus-lg"></i> Nuevo Inmueble
            </button>
        </div>
    }
</div>

@if (mostrarModalNuevo)
{
    <div class="modal-overlay" @onclick="CerrarModal"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <h4 class="fw-bold mb-2">Tipo de Inmueble</h4>
        <p class="text-muted mb-4 small">¿Qué tipo de propiedad vas a registrar?</p>

        <div class="card border mb-3 text-start shadow-sm cursor-pointer" @onclick="() => SeleccionarTipo(RentaFacil.Shared.Enums.TipoInmueble.Unico)">
            <div class="card-body d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                    <i class="bi bi-house-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Inmueble Único</h6>
                    <small class="text-muted">Casa, Departamento independiente</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </div>
        </div>

        <div class="card border mb-4 text-start shadow-sm cursor-pointer" @onclick="() => SeleccionarTipo(RentaFacil.Shared.Enums.TipoInmueble.Multiple)">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                    <i class="bi bi-building fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">Inmueble Múltiple</h6>
                    <small class="text-muted">Edificio, Complejo, Galería</small>
                </div>
                <i class="bi bi-chevron-right ms-auto text-muted"></i>
            </div>
        </div>

        <button class="btn btn-light fw-bold w-100 py-2 rounded-pill" @onclick="CerrarModal">CANCELAR</button>
    </div>
}

<!-- Bottom Sheet Opciones Inmueble -->
@if (mostrarOpciones && seleccionado != null)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarOpciones"></div>
    <div class="bottom-sheet slide-up">
        <div class="bottom-sheet-header text-center pt-2">
            <div class="bottom-sheet-handle mx-auto bg-secondary rounded-pill mb-3" style="width: 40px; height: 5px;"></div>
            <h6 class="fw-bold text-dark mb-3">@seleccionado.Nombre.ToUpper()</h6>
        </div>
        <div class="list-group list-group-flush">
            @if (seleccionado.Tipo == RentaFacil.Shared.Enums.TipoInmueble.Multiple)
            {
                <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="IrAUnidades">
                    <i class="bi bi-building-gear text-primary fs-5 me-2"></i> Ver Unidades
                </button>
            }
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="MostrarFase2Medidores">
                <i class="bi bi-speedometer2 text-warning fs-5 me-2"></i> Medidores
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="IrAEditar">
                <i class="bi bi-pencil-square text-info fs-5 me-2"></i> Editar
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold text-danger" @onclick="ConfirmarEliminar">
                <i class="bi bi-trash-fill fs-5 me-2"></i> Eliminar
            </button>
        </div>
    </div>
}

<!-- Modal Alerta Fase 2 / Confirmaciones -->
@if (mostrarAlertaFase2)
{
    <div class="modal-overlay" @onclick="() => mostrarAlertaFase2 = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-info-circle fs-3"></i>
        </div>
        <h5 class="fw-bold">Gestión de Medidores</h5>
        <p class="text-muted small">Esta característica (registro de lectura de agua/luz por unidad) estará disponible en la Fase 2 del proyecto.</p>
        <button class="btn btn-primary w-100 fw-bold rounded-pill py-2" @onclick="() => mostrarAlertaFase2 = false">Aceptar</button>
    </div>
}

@if (mostrarConfirmarEliminar && seleccionado != null)
{
    <div class="modal-overlay" @onclick="() => mostrarConfirmarEliminar = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-exclamation-triangle fs-3"></i>
        </div>
        <h5 class="fw-bold text-danger">¿Eliminar Inmueble?</h5>
        <p class="text-muted small">Esta acción borrará definitivamente el inmueble y todas sus unidades asociadas. No se puede deshacer.</p>
        
        <div class="d-flex gap-3">
            <button class="btn btn-light fw-bold w-50 py-2 rounded-pill" @onclick="() => mostrarConfirmarEliminar = false">CANCELAR</button>
            <button class="btn btn-danger fw-bold w-50 py-2 rounded-pill" @onclick="EliminarInmueble">ELIMINAR</button>
        </div>
    </div>
}

<style>
    .modal-overlay, .bottom-sheet-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .bottom-sheet {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: white; border-radius: 20px 20px 0 0;
        z-index: 1050; padding-bottom: 20px;
    }
    .scale-in { animation: scaleIn 0.3s ease; }
    @@keyframes scaleIn { from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    .slide-up { animation: slideUp 0.3s ease-out forwards; }
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .cursor-pointer { cursor: pointer; }
</style>

@code {
    private List<InmuebleDto> inmuebles = new();
    private bool cargando = true;
    private bool mostrarModalNuevo = false;
    private string errorMessage = "";

    // Bottom Sheet y Modales
    private bool mostrarOpciones = false;
    private InmuebleDto? seleccionado;
    private bool mostrarAlertaFase2 = false;
    private bool mostrarConfirmarEliminar = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            inmuebles = await Api.GetInmueblesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar inmuebles: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModal() => mostrarModalNuevo = true;
    private void CerrarModal() => mostrarModalNuevo = false;

    private void SeleccionarTipo(RentaFacil.Shared.Enums.TipoInmueble tipo)
    {
        Nav.NavigateTo($"/inmuebles/nuevo?tipo={tipo}");
    }

    private void AbrirOpciones(InmuebleDto inv)
    {
        seleccionado = inv;
        mostrarOpciones = true;
    }

    private void CerrarOpciones()
    {
        mostrarOpciones = false;
        seleccionado = null;
    }

    private void IrAUnidades()
    {
        if (seleccionado == null) return;
        var id = seleccionado.Id;
        CerrarOpciones();
        Nav.NavigateTo($"/inmuebles/{id}/unidades");
    }

    private void MostrarFase2Medidores()
    {
        mostrarOpciones = false;
        mostrarAlertaFase2 = true;
    }

    private void IrAEditar()
    {
        if (seleccionado == null) return;
        var id = seleccionado.Id;
        CerrarOpciones();
        Nav.NavigateTo($"/inmuebles/editar/{id}");
    }

    private void ConfirmarEliminar()
    {
        mostrarOpciones = false;
        mostrarConfirmarEliminar = true;
    }

    private async Task EliminarInmueble()
    {
        if (seleccionado == null) return;
        mostrarConfirmarEliminar = false;
        try
        {
            var exito = await Api.DeleteInmuebleAsync(seleccionado.Id);
            if (exito)
            {
                inmuebles.Remove(seleccionado);
            }
            else
            {
                errorMessage = "No se pudo eliminar el inmueble.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            seleccionado = null;
        }
    }

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
