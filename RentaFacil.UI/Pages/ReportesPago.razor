@page "/reportes-pago"
@using RentaFacil.Shared.Enums
@using RentaFacil.Shared.Models
@using RentaFacil.Shared.Globalization
@using RentaFacil.UI.Services
@inject ApiClient Api
@inject NavigationManager Nav
@inject SignalRClient Realtime
@implements IDisposable

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Reportes de Pago</h3>
    <div style="width: 2.5rem;"></div>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh; position: relative;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando reportes...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else
    {
        <div class="text-center mb-4 mt-2">
            <span class="bg-primary bg-opacity-10 text-primary fw-bold px-4 py-2 rounded-pill">Total: @reportes.Count</span>
        </div>

        @if (!reportes.Any())
        {
            <div class="text-center text-muted mt-5">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <p>No hay reportes de pago aún.</p>
            </div>
        }
        else
        {
            @foreach (var r in ReportesOrdenados())
            {
                <div class="card shadow-sm border-0 mb-3 rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @ClaseBadgeEstado(r.Estado) rounded-pill">@TextoEstado(r.Estado)</span>
                            <small class="text-muted">@r.FechaReporte.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <h6 class="fw-bold mb-1">@r.NombreInquilino</h6>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-secondary small">Monto reportado:</span>
                            <span class="fw-bold text-primary fs-5">@MoneyFormatter.Mostrar(r.Monto)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comentario))
                        {
                            <p class="text-muted small mb-2"><i class="bi bi-chat-left-text me-1"></i>@r.Comentario</p>
                        }

                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @if (r.TieneComprobante)
                            {
                                <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="() => VerComprobante(r.Id)">
                                    <i class="bi bi-paperclip"></i> Ver comprobante
                                </button>
                            }

                            @if (r.Estado == EstadoReportePago.Pendiente)
                            {
                                <button class="btn btn-sm btn-success rounded-pill" @onclick="() => AbrirConfirmacion(r, true)">
                                    <i class="bi bi-check-lg"></i> Confirmar
                                </button>
                                <button class="btn btn-sm btn-danger rounded-pill" @onclick="() => AbrirConfirmacion(r, false)">
                                    <i class="bi bi-x-lg"></i> Rechazar
                                </button>
                            }
                            else if (r.Estado == EstadoReportePago.Confirmado)
                            {
                                <button class="btn btn-sm btn-primary rounded-pill" @onclick="() => IrARegistrarPago(r.ContratoId)">
                                    <i class="bi bi-cash-coin"></i> Registrar pago
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Modal Ver Comprobante -->
@if (mostrarComprobante)
{
    <div class="modal-overlay" @onclick="() => mostrarComprobante = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <h5 class="fw-bold mb-3">Comprobante</h5>

        @if (cargandoComprobante)
        {
            <p class="text-center my-4"><em>Cargando comprobante...</em></p>
        }
        else if (!string.IsNullOrEmpty(errorComprobante))
        {
            <div class="alert alert-danger small">@errorComprobante</div>
        }
        else if (!string.IsNullOrEmpty(comprobanteBase64))
        {
            <img src="data:image/jpeg;base64,@comprobanteBase64" alt="Comprobante de pago" style="max-width: 100%; border-radius: 12px;" />
        }

        <button class="btn btn-light fw-bold w-100 py-2 rounded-pill mt-3" @onclick="() => mostrarComprobante = false">CERRAR</button>
    </div>
}

<!-- Modal Confirmar / Rechazar -->
@if (mostrarConfirmacion && reporteSeleccionado != null)
{
    <div class="modal-overlay" @onclick="() => mostrarConfirmacion = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="@(confirmando ? "bg-success" : "bg-danger") bg-opacity-10 @(confirmando ? "text-success" : "text-danger") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi @(confirmando ? "bi-check-lg" : "bi-x-lg") fs-3"></i>
        </div>
        <h5 class="fw-bold @(confirmando ? "text-success" : "text-danger")">¿@(confirmando ? "Confirmar" : "Rechazar") este reporte?</h5>
        <p class="text-muted small">
            @reporteSeleccionado.NombreInquilino — @MoneyFormatter.Mostrar(reporteSeleccionado.Monto)
        </p>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger small">@errorMessage</div>
        }

        <div class="d-flex gap-3">
            <button class="btn btn-light fw-bold w-50 py-2 rounded-pill" @onclick="() => mostrarConfirmacion = false">CANCELAR</button>
            <button class="btn @(confirmando ? "btn-success" : "btn-danger") fw-bold w-50 py-2 rounded-pill" @onclick="ProcesarConfirmacion">
                @(confirmando ? "CONFIRMAR" : "RECHAZAR")
            </button>
        </div>
    </div>
}

<style>
    .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .scale-in { animation: scaleIn 0.2s ease-out; }
    @@keyframes scaleIn { from { transform: translate(-50%, -50%) scale(0.95); opacity: 0; } to { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
</style>

@code {
    private List<ReportePagoDto> reportes = new();
    private bool cargando = true;
    private string errorMessage = "";

    // Modal comprobante
    private bool mostrarComprobante = false;
    private bool cargandoComprobante = false;
    private string errorComprobante = "";
    private string? comprobanteBase64;

    // Modal confirmar/rechazar
    private bool mostrarConfirmacion = false;
    private bool confirmando = true;
    private ReportePagoDto? reporteSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        await CargarReportes();

        // Tiempo real: si el inquilino reporta un pago desde otro cliente, refrescamos la bandeja.
        Realtime.CambioDatos += OnCambioDatos;
        await Realtime.IniciarAsync();
    }

    private async Task CargarReportes()
    {
        try
        {
            reportes = await Api.GetReportesPagoAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar reportes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrARegistrarPago(int contratoId)
    {
        Nav.NavigateTo($"/crearpago/{contratoId}");
    }

    private IEnumerable<ReportePagoDto> ReportesOrdenados()
        => reportes
            .OrderBy(r => r.Estado == EstadoReportePago.Pendiente ? 0 : 1)
            .ThenByDescending(r => r.FechaReporte);

    private async void OnCambioDatos(string entidad, int usuarioId, string accion)
    {
        if (entidad != "ReportePago") return;

        // El evento llega en un hilo de fondo: hay que volver al hilo de UI.
        // El refresco es best-effort: si falla, lo tragamos para no tumbar el renderer.
        try
        {
            await InvokeAsync(async () =>
            {
                reportes = await Api.GetReportesPagoAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ReportesPago] No se pudo refrescar la lista en tiempo real: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Solo desuscribimos el handler; la conexión vive a nivel DI y la
        // reutilizan otras páginas, así que NO la cerramos aquí.
        Realtime.CambioDatos -= OnCambioDatos;
    }

    private string ClaseBadgeEstado(EstadoReportePago estado) => estado switch
    {
        EstadoReportePago.Pendiente => "bg-warning text-dark",
        EstadoReportePago.Confirmado => "bg-success",
        EstadoReportePago.Rechazado => "bg-danger",
        _ => "bg-secondary"
    };

    private string TextoEstado(EstadoReportePago estado) => estado switch
    {
        EstadoReportePago.Pendiente => "PENDIENTE",
        EstadoReportePago.Confirmado => "CONFIRMADO",
        EstadoReportePago.Rechazado => "RECHAZADO",
        _ => estado.ToString().ToUpperInvariant()
    };

    private async Task VerComprobante(int reporteId)
    {
        mostrarComprobante = true;
        cargandoComprobante = true;
        errorComprobante = "";
        comprobanteBase64 = null;
        StateHasChanged();

        try
        {
            var bytes = await Api.GetComprobanteAsync(reporteId);
            if (bytes == null)
            {
                errorComprobante = "No se pudo cargar el comprobante.";
                return;
            }

            comprobanteBase64 = Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            errorComprobante = $"Error al cargar el comprobante: {ex.Message}";
        }
        finally
        {
            cargandoComprobante = false;
        }
    }

    private void AbrirConfirmacion(ReportePagoDto reporte, bool confirmar)
    {
        reporteSeleccionado = reporte;
        confirmando = confirmar;
        errorMessage = "";
        mostrarConfirmacion = true;
    }

    private async Task ProcesarConfirmacion()
    {
        if (reporteSeleccionado == null) return;
        var id = reporteSeleccionado.Id;
        try
        {
            var exito = confirmando
                ? await Api.ConfirmarReporteAsync(id)
                : await Api.RechazarReporteAsync(id);

            if (!exito)
            {
                errorMessage = confirmando
                    ? "No se pudo confirmar el reporte."
                    : "No se pudo rechazar el reporte.";
                return;
            }

            mostrarConfirmacion = false;
            reporteSeleccionado = null;
            await CargarReportes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar el reporte: {ex.Message}";
        }
    }

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
