@page "/mi/notificaciones"
@inject ApiClient Api

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Notificaciones</h3>
    <div style="width: 2.5rem; height: 2.5rem;"></div>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh; position: relative;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-1">@errorMessage</div>
    }
    else if (!notificaciones.Any())
    {
        <div class="text-center text-muted mt-4">
            <i class="bi bi-bell fs-1 d-block mb-3"></i>
            <p>No tienes notificaciones.</p>
        </div>
    }
    else
    {
        @foreach (var n in notificaciones.OrderByDescending(n => n.Fecha))
        {
            <div class="card shadow-sm border-0 mb-3 rounded-4" style="cursor: pointer;" @onclick="() => AlTocar(n)">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:44px; height:44px;">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-0 @(n.Notificado ? "" : "fw-bold")">
                            @EtiquetaTipo(n.Tipo)
                            @if (!n.Notificado)
                            {
                                <span class="badge bg-danger ms-2">Nuevo</span>
                            }
                        </h6>
                        @if (!string.IsNullOrWhiteSpace(n.Detalle))
                        {
                            <small class="text-muted d-block">@n.Detalle</small>
                        }
                        <small class="text-muted">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<MiNotificacionDto> notificaciones = new();
    private bool cargando = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            notificaciones = await Api.GetMisNotificacionesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string EtiquetaTipo(string tipo) => tipo switch
    {
        "ContratoEditado" => "Tu contrato fue modificado",
        _ => tipo
    };

    private async Task AlTocar(MiNotificacionDto n)
    {
        if (n.Notificado) return;

        try
        {
            var exito = await Api.MarcarNotificacionLeidaAsync(n.Id);
            if (exito)
            {
                notificaciones = await Api.GetMisNotificacionesAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al marcar como leída: {ex.Message}";
        }
    }

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
