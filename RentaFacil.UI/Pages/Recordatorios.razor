@page "/recordatorios"
@using RentaFacil.Shared.Models
@using RentaFacil.UI.Services
@inject ApiClient Api
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between text-white" style="margin: 0 -1rem 1rem -1rem; background-color: #2a7587; padding-top: calc(env(safe-area-inset-top, 0px) + 2rem); padding-bottom: 1rem; padding-left: 1rem; padding-right: 1rem;">
    <button class="btn btn-link text-white text-decoration-none p-0 d-flex align-items-center justify-content-center rounded-circle border border-white border-2"
            style="width: 2.5rem; height: 2.5rem; background-color: rgba(255, 255, 255, 0.15);"
            @onclick="AbrirMenu" aria-label="Abrir menú">
        <i class="bi bi-list" style="font-size: 1.6rem; line-height: 1;"></i>
    </button>
    <h3 class="mb-0 fw-bold text-center flex-grow-1" style="font-size: 1.5rem;">Recordatorios</h3>
    <div style="width: 2.5rem;"></div>
</div>

<div class="bg-white rounded-top-4 p-3" style="min-height: 80vh; position: relative;">
    @if (cargando)
    {
        <p class="text-center mt-4"><em>Cargando recordatorios...</em></p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else
    {
        <div class="text-center mb-4 mt-2">
            <span class="bg-primary bg-opacity-10 text-primary fw-bold px-4 py-2 rounded-pill">Total: @recordatorios.Count</span>
        </div>

        @if (!recordatorios.Any())
        {
            <div class="text-center text-muted mt-5">
                <i class="bi bi-bell fs-1 d-block mb-3"></i>
                <p>No tienes recordatorios registrados aún.</p>
            </div>
        }
        else
        {
            @foreach (var rec in recordatorios.OrderBy(r => r.FechaProgramada))
            {
                <div class="card shadow-sm border-0 mb-3 rounded-4" @onclick="() => AbrirOpciones(rec)" style="cursor: pointer; transition: all 0.2s;">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                                <i class="bi bi-bell-fill fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@NombreInquilino(rec.InquilinoId)</h6>
                                <small class="text-muted d-block">@rec.Detalle</small>
                                <small class="text-primary fw-bold"><i class="bi bi-calendar-event me-1"></i>@rec.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        <i class="bi bi-three-dots-vertical fs-5 text-muted"></i>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Bottom Sheet Opciones Recordatorio -->
@if (mostrarOpciones && seleccionado != null)
{
    <div class="bottom-sheet-overlay" @onclick="CerrarOpciones"></div>
    <div class="bottom-sheet slide-up">
        <div class="bottom-sheet-header text-center pt-2">
            <div class="bottom-sheet-handle mx-auto bg-secondary rounded-pill mb-3" style="width: 40px; height: 5px;"></div>
            <h6 class="fw-bold text-dark mb-3">@NombreInquilino(seleccionado.InquilinoId)</h6>
        </div>
        <div class="list-group list-group-flush">
            <button class="list-group-item list-group-item-action py-3 fw-bold" @onclick="AbrirEditar">
                <i class="bi bi-pencil-square text-info fs-5 me-2"></i> Editar
            </button>
            <button class="list-group-item list-group-item-action py-3 fw-bold text-danger" @onclick="ConfirmarEliminar">
                <i class="bi bi-trash-fill fs-5 me-2"></i> Eliminar Recordatorio
            </button>
        </div>
    </div>
}

<!-- Bottom Sheet Editar Recordatorio -->
@if (mostrarEditar && seleccionado != null)
{
    <div class="bottom-sheet-overlay" @onclick="() => mostrarEditar = false"></div>
    <div class="bottom-sheet slide-up p-4">
        <div class="text-center mb-3">
            <i class="bi bi-bell fs-1 text-warning"></i>
            <h5 class="fw-bold mt-2">@NombreInquilino(seleccionado.InquilinoId)</h5>
        </div>
        @if (!string.IsNullOrEmpty(errorEdicion))
        {
            <div class="alert alert-danger small">@errorEdicion</div>
        }
        <div class="mb-3">
            <label class="form-label fw-bold">Detalle del aviso:</label>
            <textarea class="form-control" rows="3" placeholder="Escribe tu recordatorio..." @bind="editDetalle"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Programación:</label>
            <input type="datetime-local" class="form-control" @bind="editFecha" />
        </div>
        <button class="btn btn-primary w-100 fw-bold" @onclick="GuardarEdicion">Guardar Cambios</button>
    </div>
}

<!-- Modal Confirmar Eliminar -->
@if (mostrarConfirmarEliminar && seleccionado != null)
{
    <div class="modal-overlay" @onclick="() => mostrarConfirmarEliminar = false"></div>
    <div class="modal-custom scale-in p-4 text-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-exclamation-triangle fs-3"></i>
        </div>
        <h5 class="fw-bold text-danger">¿Eliminar Recordatorio?</h5>
        <p class="text-muted small">Esta acción borrará definitivamente el recordatorio. No se puede deshacer.</p>

        <div class="d-flex gap-3">
            <button class="btn btn-light fw-bold w-50 py-2 rounded-pill" @onclick="() => mostrarConfirmarEliminar = false">CANCELAR</button>
            <button class="btn btn-danger fw-bold w-50 py-2 rounded-pill" @onclick="EliminarRecordatorio">ELIMINAR</button>
        </div>
    </div>
}

<style>
    .modal-overlay, .bottom-sheet-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 1040;
    }
    .modal-custom {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 20px; z-index: 1050;
    }
    .bottom-sheet {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: white; border-radius: 20px 20px 0 0;
        z-index: 1050; padding-bottom: 20px;
    }
    .scale-in { animation: scaleIn 0.3s ease; }
    @@keyframes scaleIn { from { opacity: 0; transform: translate(-50%, -45%) scale(0.95); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    .slide-up { animation: slideUp 0.3s ease-out forwards; }
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>

@code {
    private List<RecordatorioDto> recordatorios = new();
    private List<InquilinoDto> inquilinos = new();
    private bool cargando = true;
    private string errorMessage = "";

    // Bottom Sheet y Modales
    private bool mostrarOpciones = false;
    private RecordatorioDto? seleccionado;
    private bool mostrarConfirmarEliminar = false;

    // Edición
    private bool mostrarEditar = false;
    private string editDetalle = "";
    private DateTime editFecha = DateTime.Now;
    private string errorEdicion = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            recordatorios = await Api.GetRecordatoriosAsync();
            inquilinos = await Api.GetInquilinosAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private string NombreInquilino(int inquilinoId)
    {
        var inq = inquilinos.FirstOrDefault(i => i.Id == inquilinoId);
        return inq?.NombreCompleto ?? "Inquilino desconocido";
    }

    private void AbrirOpciones(RecordatorioDto rec)
    {
        seleccionado = rec;
        mostrarOpciones = true;
    }

    private void CerrarOpciones()
    {
        mostrarOpciones = false;
        seleccionado = null;
    }

    private void AbrirEditar()
    {
        if (seleccionado == null) return;
        mostrarOpciones = false;
        editDetalle = seleccionado.Detalle;
        editFecha = seleccionado.FechaProgramada;
        errorEdicion = "";
        mostrarEditar = true;
    }

    private async Task GuardarEdicion()
    {
        if (seleccionado == null || string.IsNullOrWhiteSpace(editDetalle)) return;
        try
        {
            var dto = new CrearRecordatorioDto(seleccionado.InquilinoId, seleccionado.ContratoId, editDetalle, editFecha);
            var exito = await Api.UpdateRecordatorioAsync(seleccionado.Id, dto);
            if (!exito)
            {
                errorEdicion = "No se pudo guardar el recordatorio.";
                return;
            }
            mostrarEditar = false;
            recordatorios = await Api.GetRecordatoriosAsync();
            seleccionado = null;
        }
        catch (Exception ex)
        {
            errorEdicion = $"Error al guardar: {ex.Message}";
        }
    }

    private void ConfirmarEliminar()
    {
        mostrarOpciones = false;
        mostrarConfirmarEliminar = true;
    }

    private async Task EliminarRecordatorio()
    {
        if (seleccionado == null) return;
        mostrarConfirmarEliminar = false;
        try
        {
            var exito = await Api.DeleteRecordatorioAsync(seleccionado.Id);
            if (exito)
            {
                recordatorios.Remove(seleccionado);
            }
            else
            {
                errorMessage = "No se pudo eliminar el recordatorio.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            seleccionado = null;
        }
    }

    [CascadingParameter] public MainLayout Layout { get; set; } = null!;

    private void AbrirMenu()
    {
        Layout?.ToggleSidebar();
    }
}
